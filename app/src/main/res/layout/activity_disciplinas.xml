<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:text="Disciplinas do Curso"
            android:textColor="@color/texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botaoProgramacao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/botao_roxo"
            android:text="Lógica de Programação"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoBancoDados"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Banco de Dados"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoEngenharia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Engenharia de Software"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoWeb"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Desenvolvimento Web"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoMobile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Desenvolvimento Mobile"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoIa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Inteligência Artificial"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoVoltarDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/botao_roxo"
            android:text="Voltar Tela Anterior"
            android:textAllCaps="false"
            android:textColor="@color/branco" />
    </LinearLayout>
</ScrollView>
