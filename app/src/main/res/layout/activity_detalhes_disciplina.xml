<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/textoNomeDisciplina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desenvolvimento Mobile"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoCargaHoraria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Carga horária: 80 horas"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textoModalidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Modalidade: Presencial"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textoNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nível: Intermediário"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textoProfessor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Professor: Prof. Leandro"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textoPreRequisito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pré-requisito: Lógica de Programação"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Descrição:"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Estuda o desenvolvimento de aplicativos para Android com Kotlin."
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <Button
            android:id="@+id/botaoCompartilhar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/botao_azul"
            android:text="Compartilhar Disciplina"
            android:textAllCaps="false"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/botaoVoltarDetalhes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/branco" />
    </LinearLayout>
</ScrollView>
