<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Logo da Unipê - Cabeçalho -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/logo_unipe"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="29dp" />

    <!-- Texto do nome da Faculdade -->

    <TextView
        android:layout_width="98dp"
        android:layout_height="46dp"
        android:text="Unipê"
        android:textSize="32sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.439" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conheça o Curso"
        tools:layout_editor_absoluteX="127dp"
        tools:layout_editor_absoluteY="505dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Disciplinas"
        tools:layout_editor_absoluteX="147dp"
        tools:layout_editor_absoluteY="591dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="375dp"
        android:layout_height="110dp"
        android:justificationMode="inter_word"
        android:lineSpacingExtra="4sp"
        android:padding="16dp"
        android:text="O curso de ADS forma profissionais capazes de projetar e implementar soluções de software..."
        android:textSize="16sp"
        tools:layout_editor_absoluteX="20dp"
        tools:layout_editor_absoluteY="372dp" />


</androidx.constraintlayout.widget.ConstraintLayout>