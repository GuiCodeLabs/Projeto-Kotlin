<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/fundo_logo"
            android:contentDescription="@string/logo_description"
            android:padding="25dp"
            android:src="@drawable/ic_chapeu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/nome_universidade"
            android:textColor="@color/texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Análise e Desenvolvimento de Sistemas"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Aprenda a criar soluções tecnológicas inovadoras."
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <Button
            android:id="@+id/botaoConheca"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/botao_roxo"
            android:text="Conheça o Curso"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="15sp" />

        <Button
            android:id="@+id/botaoDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_roxo"
            android:text="Disciplinas"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
